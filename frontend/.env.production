# Production build config for the SPA — committed ON PURPOSE.
#
# Vite INLINES VITE_* into the bundle at build time, so whatever lands here is public by
# definition; Clerk publishable keys are meant to be shipped to the browser (a pk is just
# `pk_live_`/`pk_test_` + base64 of the Frontend API host). NEVER put a real secret in this
# file: it is not git-ignored, and anything here ends up in dist/assets/*.js.
#
# The instance must match the backend's CLERK_DOMAIN / CLERK_JWKS_URL — the SPA authenticates
# against the instance whose JWKS the backend trusts. Ours is the Clerk production instance at
# https://clerk.seekeru.tech (pk derived from that host, not pasted from a dashboard).
VITE_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsuc2Vla2VydS50ZWNoJA==

# Sentry DSN — public by definition, it ships inside dist/assets/*.js; the same reasoning as the
# Clerk pk above. Errors only: this project has no tracing, replay or logging products enabled.
VITE_SENTRY_DSN=https://bd8722493587ab6497b116ea3e9d5486@o4512115587940352.ingest.us.sentry.io/4512115611140096
