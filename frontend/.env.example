# Vite build-time config. Empty value = same-origin API calls (prod, via the
# nginx /api proxy). The dev overlay sets this automatically.
VITE_API_BASE=/api

# Clerk publishable key (starts with pk_test_ or pk_live_).
#   UNCOMMENT/SET when using real Clerk auth (pre-ship, matching CLERK_ENABLED=true
#   in the root .env). Get it from the Clerk dashboard → API Keys → Publishable key.
#   Without it, <ClerkProvider publishableKey> throws at startup (main.tsx guard).
#   Dev fallback (CLERK_ENABLED=false) does NOT need this — but it's harmless to set.
VITE_CLERK_PUBLISHABLE_KEY=
