# Vite reads this at build and dev-server time. Copy to `frontend/.env`.
# Empty VITE_API_BASE = same-origin `/api`, which is what the nginx/Vite proxy serves.

VITE_API_BASE=/api

# A dev instance's `pk_test_`. `pk_live_` is locked to its production origin and is rejected on
# localhost. Empty = the app runs in no-Clerk dev mode.
VITE_CLERK_PUBLISHABLE_KEY=
