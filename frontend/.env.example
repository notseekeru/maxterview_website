# Vite build-time config. Empty value = same-origin API calls (prod, via the
# nginx /api proxy). The dev overlay sets this automatically.
VITE_API_BASE=/api

# Clerk publishable key (PUBLIC — starts `pk_test_` on a dev instance, `pk_live_` in prod).
#   Set when using real Clerk auth (matching `CLERK_ENABLED=true` in backend/.env). Grab `pk_...`
#   from the same Clerk app config showing CLERK_DOMAIN, under Settings → API keys → Publishable key.
#   A dev `.clerk.accounts.dev` instance works on localhost; `pk_live_` is locked to its prod origin.
#   Without it, the app runs in dev/no-auth mode (Clerk provider disabled, backend DEV_USER).
#   The example stays empty so a public fork pastes its own instance key.
VITE_CLERK_PUBLISHABLE_KEY=
