{
  "rules": [
    {
      "title": "{{PROJECT}}: pipeline silent",
      "condition": "C",
      "data": [
        {
          "refId": "A",
          "queryType": "range",
          "relativeTimeRange": {
            "from": 900,
            "to": 0
          },
          "datasourceUid": "{{DS_PROM}}",
          "model": {
            "editorMode": "code",
            "expr": "sum(increase(http_server_request_duration_seconds_count{service_name=\"{{APP}}\"}[15m]))",
            "instant": false,
            "legendFormat": "requests in 15m",
            "range": true,
            "refId": "A",
            "queryType": "range",
            "intervalMs": 1000,
            "maxDataPoints": 43200
          }
        },
        {
          "refId": "B",
          "queryType": "",
          "relativeTimeRange": {
            "from": 900,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "expression": "A",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "reducer": "last",
            "refId": "B",
            "type": "reduce"
          }
        },
        {
          "refId": "C",
          "queryType": "",
          "relativeTimeRange": {
            "from": 900,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "conditions": [
              {
                "evaluator": {
                  "type": "lt",
                  "params": [
                    1
                  ]
                }
              }
            ],
            "expression": "B",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "C",
            "type": "threshold"
          }
        }
      ],
      "noDataState": "Alerting",
      "execErrState": "Error",
      "for": "5m",
      "keep_firing_for": "0s",
      "annotations": {
        "description": "The `{{PROJECT}}-heartbeat` CronJob fetches /api/ping every minute in-cluster and that request is sampled like any other, so an empty 15m window means the export path is dead and not idle: OTLP delivery stopped, the Alloy pod is gone, or its write credential was revoked. Every other rule in this group sits at noDataState=OK, because an app with no traffic genuinely has no 5xx, no model calls and no tracebacks; this is the one rule that treats missing data as the failure itself.",
        "summary": "{{PROJECT}}: pipeline silent"
      },
      "labels": {
        "severity": "critical"
      },
      "isPaused": false,
      "notification_settings": {
        "receiver": "{{RECEIVER}}"
      }
    }
  ]
}
