{
  "rules": [
    {
      "title": "{{PROJECT}}: site unreachable",
      "condition": "C",
      "data": [
        {
          "refId": "A",
          "queryType": "",
          "relativeTimeRange": {
            "from": 300,
            "to": 0
          },
          "datasourceUid": "{{DS_INFINITY}}",
          "model": {
            "refId": "A",
            "type": "infinity",
            "source": "url",
            "format": "json",
            "url": "{{PROBE_URL}}",
            "url_options": {
              "method": "GET"
            },
            "parser": "backend",
            "root_selector": ""
          }
        },
        {
          "refId": "B",
          "queryType": "",
          "relativeTimeRange": {
            "from": 300,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "expression": "A",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "reducer": "last",
            "refId": "B",
            "type": "reduce"
          }
        },
        {
          "refId": "C",
          "queryType": "",
          "relativeTimeRange": {
            "from": 300,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "conditions": [
              {
                "evaluator": {
                  "type": "lt",
                  "params": [
                    1
                  ]
                }
              }
            ],
            "expression": "B",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "C",
            "type": "threshold"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "Alerting",
      "for": "2m",
      "keep_firing_for": "0s",
      "annotations": {
        "description": "The alerting engine runs this HTTP GET from Grafana Cloud, not from the node, so it is the only rule that tests the path a visitor takes: DNS, the edge, the tunnel, the ingress and the app. It fires on the query failing (non-2xx, TLS, DNS, timeout) and not on a value: a 200 whose body parses to nothing is the healthy answer here, which is why `noDataState` is `OK` and the target is the telemetry-exempt `/api/health` rather than the pulse route.",
        "summary": "{{PROJECT}}: site unreachable"
      },
      "labels": {
        "severity": "critical"
      },
      "isPaused": false,
      "notification_settings": {
        "receiver": "{{RECEIVER}}",
        "repeat_interval": "1h"
      }
    }
  ]
}
