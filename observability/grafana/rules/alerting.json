            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "queryType": "range",
            "refId": "A"
          }
        },
        {
          "refId": "B",
          "queryType": "",
          "relativeTimeRange": {
            "from": 1800,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "expression": "A",
            "intervalMs": 1000,
