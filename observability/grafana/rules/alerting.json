            "reducer": "last",
            "refId": "B",
            "type": "reduce"
          }
        },
        {
          "refId": "C",
          "queryType": "",
          "relativeTimeRange": {
            "from": 1800,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
