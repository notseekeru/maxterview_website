{
  "title": "{{PROJECT}}-logs",
  "folderUid": "{{PROJECT}}",
  "interval": 60,
  "rules": [
    {
      "title": "{{PROJECT}}: backend 5xx",
      "condition": "C",
      "data": [
        {
          "refId": "A",
          "queryType": "range",
          "relativeTimeRange": {
            "from": 900,
            "to": 0
          },
          "datasourceUid": "{{DS_PROM}}",
          "model": {
            "editorMode": "code",
            "expr": "sum(increase(http_server_request_duration_seconds_count{service_name=\"{{APP}}\", http_response_status_code=~\"5..\"}[15m]))",
            "instant": false,
            "legendFormat": "5xx in 15m",
            "range": true,
            "refId": "A",
            "queryType": "range",
            "intervalMs": 1000,
            "maxDataPoints": 43200
          }
        },
        {
          "refId": "B",
          "queryType": "",
          "relativeTimeRange": {
            "from": 900,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "expression": "A",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "reducer": "last",
            "refId": "B",
            "type": "reduce"
          }
        },
        {
          "refId": "C",
          "queryType": "",
          "relativeTimeRange": {
            "from": 900,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "conditions": [
              {
                "evaluator": {
                  "type": "gt",
                  "params": [
                    5
                  ]
                }
              }
            ],
            "expression": "B",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "C",
            "type": "threshold"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "Error",
      "for": "1m",
      "keep_firing_for": "0s",
      "annotations": {
        "description": "More than 5 responses with a 5xx status in 15 minutes. Read the trace from one of them, then the Error logs for the exception.",
        "summary": "{{PROJECT}}: backend 5xx"
      },
      "labels": {
        "severity": "critical"
      },
      "isPaused": false
    },
    {
      "title": "{{PROJECT}}: app not reporting",
      "condition": "C",
      "data": [
        {
          "refId": "A",
          "queryType": "range",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "{{DS_PROM}}",
          "model": {
            "editorMode": "code",
            "expr": "absent(target_info{service_name=\"{{APP}}\"})",
            "instant": false,
            "legendFormat": "no samples",
            "range": true,
            "refId": "A",
            "queryType": "range",
            "intervalMs": 1000,
            "maxDataPoints": 43200
          }
        },
        {
          "refId": "B",
          "queryType": "",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "expression": "A",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "reducer": "last",
            "refId": "B",
            "type": "reduce"
          }
        },
        {
          "refId": "C",
          "queryType": "",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "conditions": [
              {
                "evaluator": {
                  "type": "gt",
                  "params": [
                    0
                  ]
                }
              }
            ],
            "expression": "B",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "C",
            "type": "threshold"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "Error",
      "for": "5m",
      "keep_firing_for": "0s",
      "annotations": {
        "description": "The app has pushed no metric sample for 5 minutes: absent(target_info) is 1 once the series is gone, and NoData (healthy, which is why noDataState is OK) while it is there. target_info is the only backend series that exists with zero traffic, so it is the one liveness marker this stack has. Every metric rule otherwise reads a counter that only appears on activity, and every log rule is noDataState=OK, so without this rule a dead OTLP export and an idle app look identical. Fires roughly 10 minutes after the last sample: 5 for Prometheus staleness plus 5 of `for`.",
        "summary": "{{PROJECT}}: app not reporting"
      },
      "labels": {
        "severity": "warning"
      },
      "isPaused": false
    },
    {
      "title": "{{PROJECT}}: backend tracebacks",
      "condition": "C",
      "data": [
        {
          "refId": "A",
          "queryType": "range",
          "relativeTimeRange": {
            "from": 900,
            "to": 0
          },
          "datasourceUid": "{{DATASOURCE}}",
          "model": {
            "editorMode": "code",
            "expr": "sum(count_over_time({app=\"{{APP}}\"} | json | level=\"error\" | event!~\"llm[.]\" [10m]))",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "queryType": "range",
            "refId": "A"
          }
        },
        {
          "refId": "B",
          "queryType": "",
          "relativeTimeRange": {
            "from": 900,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "expression": "A",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "reducer": "last",
            "refId": "B",
            "type": "reduce"
          }
        },
        {
          "refId": "C",
          "queryType": "",
          "relativeTimeRange": {
            "from": 900,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "conditions": [
              {
                "evaluator": {
                  "params": [
                    3
                  ],
                  "type": "gt"
                }
              }
            ],
            "expression": "B",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "C",
            "type": "threshold"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "Error",
      "for": "2m",
      "keep_firing_for": "0s",
      "annotations": {
        "description": "Fires above 3 on error-level lines that are not a model failure: sum(count_over_time({app=\"{{APP}}\"} | json | level=\"error\" | event!~\"llm[.]\" [10m])). What is left there is uvicorn's unhandled tracebacks and a BYOK key that failed to load; the model failures that also log at error level belong to {{PROJECT}}: model failures, so excluding them keeps one failure out of two rules.",
        "summary": "{{PROJECT}}: backend tracebacks"
      },
      "labels": {
        "severity": "warning"
      },
      "isPaused": false
    },
    {
      "title": "{{PROJECT}}: browser errors",
      "condition": "C",
      "data": [
        {
          "refId": "A",
          "queryType": "range",
          "relativeTimeRange": {
            "from": 900,
            "to": 0
          },
          "datasourceUid": "{{DATASOURCE}}",
          "model": {
            "editorMode": "code",
            "expr": "sum(count_over_time({app=\"{{APP}}\"} | json | event=\"browser.error\" [10m]))",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "queryType": "range",
            "refId": "A"
          }
        },
        {
          "refId": "B",
          "queryType": "",
          "relativeTimeRange": {
            "from": 900,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "expression": "A",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "reducer": "last",
            "refId": "B",
            "type": "reduce"
          }
        },
        {
          "refId": "C",
          "queryType": "",
          "relativeTimeRange": {
            "from": 900,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "conditions": [
              {
                "evaluator": {
                  "params": [
                    2
                  ],
                  "type": "gt"
                }
              }
            ],
            "expression": "B",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "C",
            "type": "threshold"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "Error",
      "for": "1m",
      "keep_firing_for": "0s",
      "annotations": {
        "description": "sum(count_over_time({app=\"{{APP}}\"} | json | event=\"browser.error\" [10m])) \u2014 fires above 2 (a screen broke for a real user)",
        "summary": "{{PROJECT}}: browser errors"
      },
      "labels": {
        "severity": "warning"
      },
      "isPaused": false
    },
    {
      "title": "{{PROJECT}}: telemetry export failing",
      "condition": "C",
      "data": [
        {
          "refId": "A",
          "queryType": "range",
          "relativeTimeRange": {
            "from": 900,
            "to": 0
          },
          "datasourceUid": "{{DATASOURCE}}",
          "model": {
            "editorMode": "code",
            "expr": "sum(count_over_time({app=\"{{ALLOY_APP}}\"} |= \"Exporting failed\" [15m]))",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "queryType": "range",
            "refId": "A"
          }
        },
        {
          "refId": "B",
          "queryType": "",
          "relativeTimeRange": {
            "from": 900,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "expression": "A",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "reducer": "last",
            "refId": "B",
            "type": "reduce"
          }
        },
        {
          "refId": "C",
          "queryType": "",
          "relativeTimeRange": {
            "from": 900,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "conditions": [
              {
                "evaluator": {
                  "type": "gt",
                  "params": [
                    2
                  ]
                }
              }
            ],
            "expression": "B",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "C",
            "type": "threshold"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "Error",
      "for": "5m",
      "keep_firing_for": "0s",
      "annotations": {
        "description": "More than 2 dropped OTLP batches in 15 minutes from Alloy, so traces and metric samples for that window are gone and a batch burst is how a DNS hiccup looks: 103 failures in one hour on 2026-09-25. The cause is on Alloy's own line, either an HTTP status (401 = the gateway wants its own basic-auth user, not the Loki one) or `lookup ... server misbehaving`, a CoreDNS SERVFAIL that lasts as long as the cluster resolver does. Nothing else reports either: the receiver accepts, the exporter drops, and the panels go quiet.",
        "summary": "{{PROJECT}}: telemetry export failing"
      },
      "labels": {
        "severity": "warning"
      },
      "isPaused": false
    },
    {
      "title": "{{PROJECT}}: model failures",
      "condition": "C",
      "data": [
        {
          "refId": "A",
          "queryType": "range",
          "relativeTimeRange": {
            "from": 1800,
            "to": 0
          },
          "datasourceUid": "{{DATASOURCE}}",
          "model": {
            "editorMode": "code",
            "expr": "sum(count_over_time({app=\"{{APP}}\"} | json | event=~\"llm[.](feedback|hardcore|chat)[.](formatter_unavailable|grader_unavailable|moves_unavailable|judge_unavailable|shout_unavailable|transport_error|no_json|schema_mismatch|empty_output|decision_drift|moves_mismatch|judge_mismatch|failed)\") [30m]))",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "queryType": "range",
            "refId": "A"
          }
        },
        {
          "refId": "B",
          "queryType": "",
          "relativeTimeRange": {
            "from": 1800,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "expression": "A",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "reducer": "last",
            "refId": "B",
            "type": "reduce"
          }
        },
        {
          "refId": "C",
          "queryType": "",
          "relativeTimeRange": {
            "from": 1800,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "conditions": [
              {
                "evaluator": {
                  "type": "gt",
                  "params": [
                    1
                  ]
                }
              }
            ],
            "expression": "B",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "C",
            "type": "threshold"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "Error",
      "for": "5m",
      "keep_firing_for": "0s",
      "annotations": {
        "description": "The model failures that cost a user their chat turn, their feedback or their grade, over 30 minutes: a chat turn that died mid-stream, judge, grader, formatter and moves unavailable, transport errors, unparseable JSON, a response that did not match the schema, empty output, and a decision or move set that drifted from the transcript. Left out on purpose: no_material and empty_transcript are what a candidate hears when there was nothing to grade, and stub_deterministic is stub mode. Fires above 1 event. Read from the log lines and not from llm_outcome=\"error\": only the line names the stage that failed, and it counts a retried call once where the metric counted it twice.",
        "summary": "{{PROJECT}}: model failures"
      },
      "labels": {
        "severity": "warning"
      },
      "isPaused": false
    },
    {
      "title": "{{PROJECT}}: outside dependency failing",
      "condition": "C",
      "data": [
        {
          "refId": "A",
          "queryType": "range",
          "relativeTimeRange": {
            "from": 1800,
            "to": 0
          },
          "datasourceUid": "{{DATASOURCE}}",
          "model": {
            "editorMode": "code",
            "expr": "sum(count_over_time({app=\"{{APP}}\"} | json | event=~\"voice[.](unreachable|unauthorized)|clerk[.]user_lookup_failed\" [30m]))",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "queryType": "range",
            "refId": "A"
          }
        },
        {
          "refId": "B",
          "queryType": "",
          "relativeTimeRange": {
            "from": 1800,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "expression": "A",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "reducer": "last",
            "refId": "B",
            "type": "reduce"
          }
        },
        {
          "refId": "C",
          "queryType": "",
          "relativeTimeRange": {
            "from": 1800,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "conditions": [
              {
                "evaluator": {
                  "type": "gt",
                  "params": [
                    1
                  ]
                }
              }
            ],
            "expression": "B",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "C",
            "type": "threshold"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "Error",
      "for": "5m",
      "keep_firing_for": "0s",
      "annotations": {
        "description": "The two third parties the app cannot serve without: the speech-to-text provider, unreachable or rejecting the key, and Clerk, where a failed user lookup blocks sign-in. voice.quota_exhausted is left out because that is a candidate using up their own minutes, not a fault. Fires above 1 event in 30 minutes.",
        "summary": "{{PROJECT}}: outside dependency failing"
      },
      "labels": {
        "severity": "warning"
      },
      "isPaused": false
    }
  ]
}
