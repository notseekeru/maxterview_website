{
  "title": "{{PROJECT}}-logs",
  "folderUid": "{{PROJECT}}",
  "interval": 60,
  "rules": [
    {
      "title": "{{PROJECT}}: backend 5xx",
      "condition": "C",
      "data": [
        {
          "refId": "A",
          "queryType": "range",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "{{DATASOURCE}}",
          "model": {
            "editorMode": "code",
            "expr": "sum(count_over_time({app=\"{{APP}}\"} | json | status >= 500 [5m]))",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "queryType": "range",
            "refId": "A"
          }
        },
        {
          "refId": "B",
          "queryType": "",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "expression": "A",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "reducer": "last",
            "refId": "B",
            "type": "reduce"
          }
        },
        {
          "refId": "C",
          "queryType": "",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "conditions": [
              {
                "evaluator": {
                  "params": [
                    5
                  ],
                  "type": "gt"
                }
              }
            ],
            "expression": "B",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "C",
            "type": "threshold"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "Error",
      "for": "1m",
      "keep_firing_for": "0s",
      "annotations": {
        "description": "sum(count_over_time({app=\"{{APP}}\"} | json | status >= 500 [5m])) \u2014 fires above 5",
        "summary": "{{PROJECT}}: backend 5xx"
      },
      "labels": {
        "severity": "critical"
      },
      "isPaused": false,
      "notification_settings": {
        "receiver": "{{RECEIVER}}"
      }
    },
    {
      "title": "{{PROJECT}}: llm failures",
