{
  "title": "{{PROJECT}}-logs",
  "folderUid": "{{PROJECT}}",
  "interval": 60,
  "rules": [
    {
      "title": "{{PROJECT}}: backend 5xx",
      "condition": "C",
      "data": [
        {
          "refId": "A",
          "queryType": "range",
          "relativeTimeRange": {
            "from": 900,
            "to": 0
          },
          "datasourceUid": "{{DS_PROM}}",
          "model": {
            "editorMode": "code",
            "expr": "sum(increase(http_server_request_duration_seconds_count{service_name=\"{{APP}}\", http_response_status_code=~\"5..\"}[15m]))",
            "instant": false,
            "legendFormat": "5xx in 15m",
            "range": true,
            "refId": "A",
            "queryType": "range",
            "intervalMs": 1000,
            "maxDataPoints": 43200
          }
        },
        {
          "refId": "B",
          "queryType": "",
          "relativeTimeRange": {
            "from": 900,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "expression": "A",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "reducer": "last",
            "refId": "B",
            "type": "reduce"
          }
        },
        {
          "refId": "C",
          "queryType": "",
          "relativeTimeRange": {
            "from": 900,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "conditions": [
              {
                "evaluator": {
                  "type": "gt",
                  "params": [
                    5
                  ]
                }
              }
            ],
            "expression": "B",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "C",
            "type": "threshold"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "Error",
      "for": "1m",
      "keep_firing_for": "0s",
      "annotations": {
        "description": "More than 5 responses with a 5xx status in 15 minutes. Read the trace from one of them, then the Error logs for the exception.",
        "summary": "{{PROJECT}}: backend 5xx"
      },
      "labels": {
        "severity": "critical"
      },
      "isPaused": false,
      "notification_settings": {
        "receiver": "{{RECEIVER}}"
      }
    },
    {
      "title": "{{PROJECT}}: llm failures",
      "condition": "C",
      "data": [
        {
          "refId": "A",
          "queryType": "range",
          "relativeTimeRange": {
            "from": 900,
            "to": 0
          },
          "datasourceUid": "{{DS_PROM}}",
          "model": {
            "editorMode": "code",
            "expr": "sum(increase(llm_client_call_duration_seconds_count{service_name=\"{{APP}}\", llm_outcome=\"error\"}[15m]))",
            "instant": false,
            "legendFormat": "model errors in 15m",
            "range": true,
            "refId": "A",
            "queryType": "range",
            "intervalMs": 1000,
            "maxDataPoints": 43200
          }
        },
        {
          "refId": "B",
          "queryType": "",
          "relativeTimeRange": {
            "from": 900,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "expression": "A",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "reducer": "last",
            "refId": "B",
            "type": "reduce"
          }
        },
        {
          "refId": "C",
          "queryType": "",
          "relativeTimeRange": {
            "from": 900,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "conditions": [
              {
                "evaluator": {
                  "type": "gt",
                  "params": [
                    2
                  ]
                }
              }
            ],
            "expression": "B",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "C",
            "type": "threshold"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "Error",
      "for": "1m",
      "keep_firing_for": "0s",
      "annotations": {
        "description": "More than 2 failed model calls in 15 minutes, across every stage. A cancelled stream (the browser left) does not count: only the provider failing.",
        "summary": "{{PROJECT}}: llm failures"
      },
      "labels": {
        "severity": "warning"
      },
      "isPaused": false,
      "notification_settings": {
        "receiver": "{{RECEIVER}}"
      }
    },
    {
      "title": "{{PROJECT}}: backend tracebacks",
      "condition": "C",
      "data": [
        {
          "refId": "A",
          "queryType": "range",
          "relativeTimeRange": {
            "from": 900,
            "to": 0
          },
          "datasourceUid": "{{DATASOURCE}}",
          "model": {
            "editorMode": "code",
            "expr": "sum(count_over_time({app=\"{{APP}}\"} | json | level=\"error\" [10m]))",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "queryType": "range",
            "refId": "A"
          }
        },
        {
          "refId": "B",
          "queryType": "",
          "relativeTimeRange": {
            "from": 900,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "expression": "A",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "reducer": "last",
            "refId": "B",
            "type": "reduce"
          }
        },
        {
          "refId": "C",
          "queryType": "",
          "relativeTimeRange": {
            "from": 900,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "conditions": [
              {
                "evaluator": {
                  "params": [
                    3
                  ],
                  "type": "gt"
                }
              }
            ],
            "expression": "B",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "C",
            "type": "threshold"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "Error",
      "for": "2m",
      "keep_firing_for": "0s",
      "annotations": {
        "description": "sum(count_over_time({app=\"{{APP}}\"} | json | level=\"error\" [10m])) \u2014 fires above 3",
        "summary": "{{PROJECT}}: backend tracebacks"
      },
      "labels": {
        "severity": "warning"
      },
      "isPaused": false,
      "notification_settings": {
        "receiver": "{{RECEIVER}}"
      }
    },
    {
      "title": "{{PROJECT}}: browser errors",
      "condition": "C",
      "data": [
        {
          "refId": "A",
          "queryType": "range",
          "relativeTimeRange": {
            "from": 900,
            "to": 0
          },
          "datasourceUid": "{{DATASOURCE}}",
          "model": {
            "editorMode": "code",
            "expr": "sum(count_over_time({app=\"{{APP}}\"} | json | event=\"browser.error\" [10m]))",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "queryType": "range",
            "refId": "A"
          }
        },
        {
          "refId": "B",
          "queryType": "",
          "relativeTimeRange": {
            "from": 900,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "expression": "A",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "reducer": "last",
            "refId": "B",
            "type": "reduce"
          }
        },
        {
          "refId": "C",
          "queryType": "",
          "relativeTimeRange": {
            "from": 900,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "conditions": [
              {
                "evaluator": {
                  "params": [
                    2
                  ],
                  "type": "gt"
                }
              }
            ],
            "expression": "B",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "C",
            "type": "threshold"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "Error",
      "for": "1m",
      "keep_firing_for": "0s",
      "annotations": {
        "description": "sum(count_over_time({app=\"{{APP}}\"} | json | event=\"browser.error\" [10m])) \u2014 fires above 2 (a screen broke for a real user)",
        "summary": "{{PROJECT}}: browser errors"
      },
      "labels": {
        "severity": "warning"
      },
      "isPaused": false,
      "notification_settings": {
        "receiver": "{{RECEIVER}}"
      }
    }
  ]
}
