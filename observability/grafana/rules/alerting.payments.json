{
  "rules": [
    {
      "title": "{{PROJECT}}: payment provider failing",
      "condition": "C",
      "data": [
        {
          "refId": "A",
          "queryType": "range",
          "relativeTimeRange": {
            "from": 900,
            "to": 0
          },
          "datasourceUid": "{{DATASOURCE}}",
          "model": {
            "editorMode": "code",
            "expr": "sum(count_over_time({app=\"{{APP}}\"} | json | event=\"paymongo.request_failed\" [15m]))",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "queryType": "range",
            "refId": "A"
          }
        },
        {
          "refId": "B",
          "queryType": "",
          "relativeTimeRange": {
            "from": 900,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "expression": "A",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "reducer": "last",
            "refId": "B",
            "type": "reduce"
          }
        },
        {
          "refId": "C",
          "queryType": "",
          "relativeTimeRange": {
            "from": 900,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "conditions": [
              {
                "evaluator": {
                  "type": "gt",
                  "params": [
                    2
                  ]
                }
              }
            ],
            "expression": "B",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "C",
            "type": "threshold"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "Error",
      "for": "1m",
      "keep_firing_for": "0s",
      "annotations": {
        "description": "More than 2 refused calls to PayMongo in 15 minutes: minting an intent, attaching a method, reading a status or a customer. `path`, `status` and the provider's `body` are on the line, and only the last 500 characters of it. 400 `payment_method_not_allowed` is a mode mismatch rather than an outage: live refuses the e-wallets and only QR Ph is attachable.",
        "summary": "{{PROJECT}}: payment provider failing"
      },
      "labels": {
        "severity": "warning"
      },
      "isPaused": false
    },
    {
      "title": "{{PROJECT}}: payment webhook dropped",
      "condition": "C",
      "data": [
        {
          "refId": "A",
          "queryType": "range",
          "relativeTimeRange": {
            "from": 900,
            "to": 0
          },
          "datasourceUid": "{{DATASOURCE}}",
          "model": {
            "editorMode": "code",
            "expr": "sum(count_over_time({app=\"{{APP}}\"} | json | event=\"paymongo.webhook_signature.stale\" [15m]))",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "queryType": "range",
            "refId": "A"
          }
        },
        {
          "refId": "B",
          "queryType": "",
          "relativeTimeRange": {
            "from": 900,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "expression": "A",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "reducer": "last",
            "refId": "B",
            "type": "reduce"
          }
        },
        {
          "refId": "C",
          "queryType": "",
          "relativeTimeRange": {
            "from": 900,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "conditions": [
              {
                "evaluator": {
                  "type": "gt",
                  "params": [
                    0
                  ]
                }
              }
            ],
            "expression": "B",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "C",
            "type": "threshold"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "Error",
      "for": "0s",
      "keep_firing_for": "0s",
      "annotations": {
        "description": "A genuine PayMongo delivery that arrived outside the 300 second signature tolerance, so the handler refused it and premium was never written while the money moved: `age_s` and `tolerance_s` are on the line. `stale` is the only signature reason that means a real payment was lost. `malformed` and `mismatch` are a header or a secret problem and belong to the webhook rejected rule. Fires on the first one.",
        "summary": "{{PROJECT}}: payment webhook dropped"
      },
      "labels": {
        "severity": "critical"
      },
      "isPaused": false
    },
    {
      "title": "{{PROJECT}}: payment webhook rejected",
      "condition": "C",
      "data": [
        {
          "refId": "A",
          "queryType": "range",
          "relativeTimeRange": {
            "from": 900,
            "to": 0
          },
          "datasourceUid": "{{DATASOURCE}}",
          "model": {
            "editorMode": "code",
            "expr": "sum(count_over_time({app=\"{{APP}}\"} | json | event=~\"paymongo[.]webhook_signature[.](malformed|mismatch)\" [15m]))",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "queryType": "range",
            "refId": "A"
          }
        },
        {
          "refId": "B",
          "queryType": "",
          "relativeTimeRange": {
            "from": 900,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "expression": "A",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "reducer": "last",
            "refId": "B",
            "type": "reduce"
          }
        },
        {
          "refId": "C",
          "queryType": "",
          "relativeTimeRange": {
            "from": 900,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "conditions": [
              {
                "evaluator": {
                  "type": "gt",
                  "params": [
                    2
                  ]
                }
              }
            ],
            "expression": "B",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "C",
            "type": "threshold"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "Error",
      "for": "1m",
      "keep_firing_for": "0s",
      "annotations": {
        "description": "Deliveries refused before the payload was trusted: `malformed` is a header missing its timestamp or signature slot, `mismatch` is the wrong secret or a forger (`livemode_slot` says which slot the provider did send), and the event on the line names the reason. Fires above 2 in 15 minutes: one probe should not page, a sustained mismatch is a secret that drifted. A real delivery that merely arrived late is `stale`, which the dropped rule pages on. 400 `payment_method_not_allowed` is a mode mismatch rather than an outage and is not logged as a signature failure.",
        "summary": "{{PROJECT}}: payment webhook rejected"
      },
      "labels": {
        "severity": "warning"
      },
      "isPaused": false
    },
    {
      "title": "{{PROJECT}}: money unattributable",
      "condition": "C",
      "data": [
        {
          "refId": "A",
          "queryType": "range",
          "relativeTimeRange": {
            "from": 1800,
            "to": 0
          },
          "datasourceUid": "{{DATASOURCE}}",
          "model": {
            "editorMode": "code",
            "expr": "sum(count_over_time({app=\"{{APP}}\"} | json | event=~\"paymongo[.]webhook[.](payment_without_intent|unattributable_refund)\" [30m]))",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "queryType": "range",
            "refId": "A"
          }
        },
        {
          "refId": "B",
          "queryType": "",
          "relativeTimeRange": {
            "from": 1800,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "expression": "A",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "reducer": "last",
            "refId": "B",
            "type": "reduce"
          }
        },
        {
          "refId": "C",
          "queryType": "",
          "relativeTimeRange": {
            "from": 1800,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "conditions": [
              {
                "evaluator": {
                  "type": "gt",
                  "params": [
                    0
                  ]
                }
              }
            ],
            "expression": "B",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "C",
            "type": "threshold"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "Error",
      "for": "0s",
      "keep_firing_for": "0s",
      "annotations": {
        "description": "Money that reached no owner: a paid event carrying no intent id at all, or a settled refund whose ids chain back to no row (`payment_id`, `refund_id` and `payment_intent_id` are on the line). Either premium is still serving on money that came back, or a payment bought nothing. Never normal, so it fires on the first one: reconcile it by hand, the handler refuses to guess an owner (MONETIZATION \u00a75).",
        "summary": "{{PROJECT}}: money unattributable"
      },
      "labels": {
        "severity": "critical"
      },
      "isPaused": false
    }
  ]
}
