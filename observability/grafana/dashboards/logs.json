{
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 25,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "sum by (level) (count_over_time({app=\"$app\"} | json | __error__=\"\" [$__auto]))",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Log volume by level",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          },
          "unit": "reqps"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "5xx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "editorMode": "code",
          "expr": "sum(rate(http_server_request_duration_seconds_count{service_name=\"$app\"}[$__rate_interval]))",
          "legendFormat": "requests",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "editorMode": "code",
          "expr": "sum(rate(http_server_request_duration_seconds_count{service_name=\"$app\", http_response_status_code=~\"5..\"}[$__rate_interval]))",
          "legendFormat": "5xx",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Request rate (5xx overlay)",
      "type": "timeseries",
      "description": "Every request that reached the app, from the OTLP histogram. /api/health is not recorded, so this is not traffic, it is work."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 10,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, http_route) (rate(http_server_request_duration_seconds_bucket{service_name=\"$app\"}[$__rate_interval])))",
          "legendFormat": "p95 \u00b7 {{http_route}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "editorMode": "code",
          "expr": "sum(rate(http_server_request_duration_seconds_sum{service_name=\"$app\"}[$__rate_interval])) / sum(rate(http_server_request_duration_seconds_count{service_name=\"$app\"}[$__rate_interval]))",
          "legendFormat": "mean",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Request duration (p95 per route)",
      "type": "timeseries",
      "description": "True percentiles from the OTLP histogram. The route label is the matched template, so it stays one series per endpoint."
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "h": 9,
        "w": 14,
        "x": 10,
        "y": 8
      },
      "id": 4,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "{app=\"$app\"} | json | level=\"error\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Errors",
      "type": "logs"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "red",
            "mode": "fixed"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 40,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 17
      },
      "id": 5,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "sum(count_over_time({app=\"$app\"} | json | event=\"browser.error\" [$__auto]))",
          "legendFormat": "browser errors",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Browser errors",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          },
          "unit": "s"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "failures"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 17
      },
      "id": 6,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, llm_stage) (rate(llm_client_call_duration_seconds_bucket{service_name=\"$app\"}[$__rate_interval])))",
          "legendFormat": "p95 \u00b7 {{llm_stage}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "editorMode": "code",
          "expr": "sum by (llm_stage) (rate(llm_client_call_duration_seconds_sum{service_name=\"$app\"}[$__rate_interval])) / sum by (llm_stage) (rate(llm_client_call_duration_seconds_count{service_name=\"$app\"}[$__rate_interval]))",
          "legendFormat": "mean \u00b7 {{llm_stage}}",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "editorMode": "code",
          "expr": "sum by (llm_stage) (rate(llm_client_call_duration_seconds_count{service_name=\"$app\", llm_outcome=\"error\"}[$__rate_interval]))",
          "legendFormat": "errors \u00b7 {{llm_stage}}",
          "range": true,
          "refId": "C"
        }
      ],
      "title": "LLM latency and failures by stage",
      "type": "timeseries",
      "description": "`cancelled` is the browser closing the stream; `error` is the provider failing."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 25
      },
      "id": 7,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(db_pool_wait_duration_seconds_bucket{service_name=\"$app\"}[$__rate_interval])))",
          "legendFormat": "pool wait p95",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, db_operation) (rate(db_query_duration_seconds_bucket{service_name=\"$app\"}[$__rate_interval])))",
          "legendFormat": "query p95 {{db_operation}}",
          "refId": "B",
          "range": true
        }
      ],
      "title": "Database wait and query",
      "type": "timeseries",
      "description": "The two halves of database time, sampled apart on purpose: waiting for a pooled connection, and running the query. The rule that fires on a 5 second wait is pointed at this panel, which is why it exists. Baseline here is a pool wait p95 near 0.9s against a query p95 under 0.32s, because Neon scales to zero and the pool starts empty, so a slow request is usually the wait and not the work."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 25
      },
      "id": 8,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "editorMode": "code",
          "expr": "sum(increase(http_server_request_duration_seconds_count{service_name=\"$app\"}[$__range])) or vector(0)",
          "legendFormat": "requests",
          "refId": "A",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "editorMode": "code",
          "expr": "sum(increase(http_server_request_duration_seconds_count{service_name=\"$app\", http_route=\"/api/interviews\", http_request_method=\"POST\"}[$__range])) or vector(0)",
          "legendFormat": "interviews created",
          "refId": "B",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "editorMode": "code",
          "expr": "sum(increase(http_server_request_duration_seconds_count{service_name=\"$app\", http_route=\"/api/interviews/{interview_id}/feedback/generate\"}[$__range])) or vector(0)",
          "legendFormat": "feedback runs",
          "refId": "C",
          "instant": true,
          "range": false
        }
      ],
      "title": "Usage",
      "type": "stat",
      "description": "Whether anyone is using it, over whatever range the dashboard shows: requests that reached the app, interviews actually created, and feedback runs. The log volume panel is only a proxy for this, at roughly 1.5 to 2 lines per request. Read, never alerted on: a quiet week is not a fault here."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 33
      },
      "id": 9,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "editorMode": "code",
          "expr": "db_pool_size{service_name=\"$app\"}",
          "legendFormat": "size",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "editorMode": "code",
          "expr": "db_pool_idle{service_name=\"$app\"}",
          "legendFormat": "idle",
          "refId": "B",
          "range": true
        }
      ],
      "title": "Database pool",
      "type": "timeseries",
      "description": "Connections the pool holds and how many of them are idle, read with each query. In use is the gap between the two, and idle at zero is the pool at its cap, which is when the wait climbs."
    }
  ],
  "refresh": "1m",
  "tags": [
    "observability-kit"
  ],
  "templating": {
    "list": [
      {
        "current": {
          "selected": true,
          "text": "{{DATASOURCE}}",
          "value": "{{DATASOURCE}}"
        },
        "hide": 0,
        "label": "Loki",
        "name": "DS_LOKI",
        "query": "loki",
        "refresh": 0,
        "type": "datasource"
      },
      {
        "current": {
          "selected": true,
          "text": "{{APP}}",
          "value": "{{APP}}"
        },
        "definition": "{{APP}}",
        "hide": 0,
        "label": "app",
        "name": "app",
        "query": "{{APP}}",
        "refresh": 0,
        "type": "custom"
      },
      {
        "current": {
          "selected": true,
          "text": "{{DS_PROM}}",
          "value": "{{DS_PROM}}"
        },
        "hide": 0,
        "label": "Prometheus",
        "name": "DS_PROM",
        "query": "prometheus",
        "refresh": 0,
        "type": "datasource"
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "{{PROJECT}}: logs & metrics",
  "uid": "{{PROJECT}}-logs"
}
