{
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 25,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "sum by (level) (count_over_time({app=\"$app\"} | json | __error__=\"\" [$__auto]))",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Log volume by level",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          },
          "unit": "reqps"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "5xx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "editorMode": "code",
          "expr": "sum(rate(http_server_request_duration_seconds_count{service_name=\"$app\"}[$__rate_interval]))",
          "legendFormat": "requests",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "editorMode": "code",
          "expr": "sum(rate(http_server_request_duration_seconds_count{service_name=\"$app\", http_response_status_code=~\"5..\"}[$__rate_interval]))",
          "legendFormat": "5xx",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Request rate (5xx overlay)",
      "type": "timeseries",
      "description": "Every request that reached the app, from the OTLP histogram. /api/health is not recorded, so this is not traffic, it is work."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 10,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, http_route) (rate(http_server_request_duration_seconds_bucket{service_name=\"$app\"}[$__rate_interval])))",
          "legendFormat": "p95 \u00b7 {{http_route}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "editorMode": "code",
          "expr": "sum(rate(http_server_request_duration_seconds_sum{service_name=\"$app\"}[$__rate_interval])) / sum(rate(http_server_request_duration_seconds_count{service_name=\"$app\"}[$__rate_interval]))",
          "legendFormat": "mean",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Request duration (p95 per route)",
      "type": "timeseries",
      "description": "True percentiles from the OTLP histogram. The route label is the matched template, so it stays one series per endpoint."
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "h": 9,
        "w": 14,
        "x": 10,
        "y": 8
      },
      "id": 4,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "{app=\"$app\"} | json | level=\"error\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Errors",
      "type": "logs"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "red",
            "mode": "fixed"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 40,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 17
      },
      "id": 5,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "sum(count_over_time({app=\"$app\"} | json | event=\"browser.error\" [$__auto]))",
          "legendFormat": "browser errors",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Browser errors",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          },
          "unit": "s"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "failures"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 17
      },
      "id": 6,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, llm_stage) (rate(llm_client_call_duration_seconds_bucket{service_name=\"$app\"}[$__rate_interval])))",
          "legendFormat": "p95 \u00b7 {{llm_stage}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "editorMode": "code",
          "expr": "sum by (llm_stage) (rate(llm_client_call_duration_seconds_sum{service_name=\"$app\"}[$__rate_interval])) / sum by (llm_stage) (rate(llm_client_call_duration_seconds_count{service_name=\"$app\"}[$__rate_interval]))",
          "legendFormat": "mean \u00b7 {{llm_stage}}",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "editorMode": "code",
          "expr": "sum by (llm_stage) (rate(llm_client_call_duration_seconds_count{service_name=\"$app\", llm_outcome=\"error\"}[$__rate_interval]))",
          "legendFormat": "errors \u00b7 {{llm_stage}}",
          "range": true,
          "refId": "C"
        }
      ],
      "title": "LLM latency and failures by stage",
      "type": "timeseries",
      "description": "`cancelled` is the browser closing the stream; `error` is the provider failing."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          },
          "unit": "s"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "pool size"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "pool idle"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 25
      },
      "id": 7,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(db_pool_wait_duration_seconds_bucket{service_name=\"$app\"}[$__rate_interval])))",
          "legendFormat": "pool wait p95",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, db_operation) (rate(db_query_duration_seconds_bucket{service_name=\"$app\"}[$__rate_interval])))",
          "legendFormat": "query p95 {{db_operation}}",
          "refId": "B",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "editorMode": "code",
          "expr": "db_pool_size_ratio{service_name=\"$app\"}",
          "legendFormat": "pool size",
          "refId": "C",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "editorMode": "code",
          "expr": "db_pool_idle_ratio{service_name=\"$app\"}",
          "legendFormat": "pool idle",
          "refId": "D",
          "range": true
        }
      ],
      "title": "Database: wait, query, pool",
      "type": "timeseries",
      "description": "Database time and database connections in one place: the two halves of a query's cost, waiting for a pooled connection and running it, plus the pool's size and idle count. Waiting is measured apart from working on purpose, because only one of the two is the database's. The pool's series are on the right axis."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 25
      },
      "id": 8,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "editorMode": "code",
          "expr": "sum(increase(http_server_request_duration_seconds_count{service_name=\"$app\"}[$__range])) or vector(0)",
          "legendFormat": "requests",
          "refId": "A",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "editorMode": "code",
          "expr": "sum(increase(http_server_request_duration_seconds_count{service_name=\"$app\", http_route=\"/api/interviews\", http_request_method=\"POST\"}[$__range])) or vector(0)",
          "legendFormat": "interviews created",
          "refId": "B",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "editorMode": "code",
          "expr": "sum(increase(http_server_request_duration_seconds_count{service_name=\"$app\", http_route=\"/api/interviews/{interview_id}/feedback/generate\"}[$__range])) or vector(0)",
          "legendFormat": "feedback runs",
          "refId": "C",
          "instant": true,
          "range": false
        }
      ],
      "title": "Usage",
      "type": "stat",
      "description": "Whether anyone is using it, over whatever range the dashboard shows: requests that reached the app, interviews actually created, and feedback runs. The log volume panel is only a proxy for this, at roughly 1.5 to 2 lines per request. Read, never alerted on: a quiet week is not a fault here."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 41
      },
      "id": 10,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "editorMode": "code",
          "expr": "sum(rate(container_cpu_usage_seconds_total{id=\"/\"}[$__rate_interval]))",
          "legendFormat": "node, all cores",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "editorMode": "code",
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"{{PROJECT}}\", container!=\"\"}[$__rate_interval]))",
          "legendFormat": "{{pod}}",
          "refId": "B",
          "range": true
        }
      ],
      "title": "CPU: node and pods",
      "type": "timeseries",
      "description": "The node against the pods on it, as cores. Both come from cAdvisor's root cgroup and the pod cgroups inside it, so a pod's line can never exceed the node's."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 41
      },
      "id": 11,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "editorMode": "code",
          "expr": "min by (device) ((container_fs_limit_bytes{id=\"/\", device=~\"/dev/(sd|nvme|mmcblk|vd)[a-z0-9]*\"} - container_fs_usage_bytes{id=\"/\", device=~\"/dev/(sd|nvme|mmcblk|vd)[a-z0-9]*\"}) / container_fs_limit_bytes{id=\"/\", device=~\"/dev/(sd|nvme|mmcblk|vd)[a-z0-9]*\"})",
          "legendFormat": "disk free {{device}}",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "editorMode": "code",
          "expr": "max by (pod, container) (container_memory_working_set_bytes{namespace=\"{{PROJECT}}\", container!=\"\"}) / max by (pod, container) (container_spec_memory_limit_bytes{namespace=\"{{PROJECT}}\", container!=\"\"})",
          "legendFormat": "{{pod}} of its limit",
          "refId": "B",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "editorMode": "code",
          "expr": "container_memory_rss{id=\"/\"} / on() group_left machine_memory_bytes",
          "legendFormat": "node memory (anonymous)",
          "refId": "C",
          "range": true
        }
      ],
      "title": "Saturation: disk and pod memory",
      "type": "timeseries",
      "description": "The ceilings a run can hit: free space on the node's filesystems, each container's working set against the limit its cgroup was given, and the node's anonymous memory against its capacity. All from the kubelet; the rules that read these carry their own thresholds."
    }
  ],
  "refresh": "1m",
  "tags": [
    "observability-kit"
  ],
  "templating": {
    "list": [
      {
        "current": {
          "selected": true,
          "text": "{{DATASOURCE}}",
          "value": "{{DATASOURCE}}"
        },
        "hide": 0,
        "label": "Loki",
        "name": "DS_LOKI",
        "query": "loki",
        "refresh": 0,
        "type": "datasource"
      },
      {
        "current": {
          "selected": true,
          "text": "{{APP}}",
          "value": "{{APP}}"
        },
        "definition": "{{APP}}",
        "hide": 0,
        "label": "app",
        "name": "app",
        "query": "{{APP}}",
        "refresh": 0,
        "type": "custom"
      },
      {
        "current": {
          "selected": true,
          "text": "{{DS_PROM}}",
          "value": "{{DS_PROM}}"
        },
        "hide": 0,
        "label": "Prometheus",
        "name": "DS_PROM",
        "query": "prometheus",
        "refresh": 0,
        "type": "datasource"
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "{{PROJECT}}: logs & metrics",
  "uid": "{{PROJECT}}-logs"
}
