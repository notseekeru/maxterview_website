{
  "mcpServers": {
    "playwright": {
      "command": "playwright-mcp",
      "args": ["--headless", "--isolated", "--browser", "chromium"],
      "lifecycle": "lazy"
    },
    "neon": {
      "url": "https://mcp.neon.tech/mcp",
      "auth": "bearer",
      "bearerToken": "!sed -n 's/^NEON_API_KEY=//p' .env | head -1",
      "protocolVersion": "auto",
      "lifecycle": "lazy",
      "approveTools": ["*delete*", "*drop*", "*reset*", "*truncate*"]
    },
    "grafana": {
      "command": "docker",
      "args": ["run", "--rm", "-i", "-e", "GRAFANA_URL", "-e", "GRAFANA_SERVICE_ACCOUNT_TOKEN", "grafana/mcp-grafana:latest", "--transport", "stdio", "--enabled-tools", "alerting,dashboard,loki,prometheus,datasource,search,navigation"],
      "env": {
        "GRAFANA_URL": "https://sturdypoplar3317.grafana.net",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN": "!sed -n \"s/^GRAFANA_SERVICE_ACCOUNT_TOKEN=//p\" .env | head -1"
      },
      "exposure": "direct"
    }
  }
}
