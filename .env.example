# Copy to `.env` and fill in real values. NEVER commit `.env`.
# `docker compose` reads this file automatically.

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Postgres ---
POSTGRES_USER=maxterview
POSTGRES_PASSWORD=change-me
POSTGRES_DB=maxterview

# --- Ports ---
BACKEND_PORT=8000
FRONTEND_PORT=5173

# --- Clerk auth ---
# When false, auth is bypassed with a dev user so the app runs without Clerk.
CLERK_ENABLED=false
CLERK_DOMAIN=your-clerk-domain.clerk.accounts
CLERK_JWKS_URL=https://your-clerk-domain.clerk.accounts/.well-known/jwks.json
# Optional: expected `aud`/`azp` claim of Clerk tokens.
CLERK_AUDIENCE=
