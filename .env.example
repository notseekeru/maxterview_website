# Root `.env`: compose/infra values plus the Grafana MCP token. Copy to `.env`, then `make env-sync-dev`.
# Backend runtime config lives in `backend-ts/.env`; `VITE_*` lives in `frontend/.env`.
# `DATABASE_URL` and `MIGRATE_DATABASE_URL` are derived (D5), never set here.

APP_ENV=development
POSTGRES_USER=maxterview
POSTGRES_PASSWORD=change-me
POSTGRES_DB=maxterview
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Filled by `make env-sync-dev` (Infisical dev); read by the Grafana MCP server via direnv.
# GRAFANA_SERVICE_ACCOUNT_TOKEN=glsa_...
