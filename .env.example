# Root `.env` — compose / infra config. Copy to `.env` and fill in real values. NEVER commit `.env`.
# Backend runtime config (CLERK, LLM, quotas, PAYMONGO, LOG_LEVEL) is NOT here — it lives in
# `backend/.env` (git-ignored; see `backend/.env.example` for shape). Docker Compose loads both:
# `env_file: [.env, ./backend/.env]` (backend/.env overrides root on collisions).
# `DATABASE_URL` is derived, never stored here (D5): dev composes it from the POSTGRES_* vars below;
# prod injects a Neon DSN secret (README "Deployment" covers the host and TLS requirements).
# `MIGRATE_DATABASE_URL` (D12, reserved) = the migrate-role DSN. Same rule — derived in dev, injected when
# deployed — and read only by the in-cluster migration Job; unset falls back to `DATABASE_URL`.
# NEON_API_KEY is an API-scoped key for the Neon MCP server (README "Driving Neon from an agent").
# `make env-pull` fills it in below; direnv exports it to the shell for the MCP adapter, and compose
# injects it into the backend container too — the app never reads it.
# NEON_API_KEY=np_...

# Runtime. development => Clerk fallback permitted; production refuses to boot unless
# CLERK_ENABLED=true (D2 guard). Owned by the compose overlay (`${APP_ENV:-...}`), not this file.
APP_ENV=development

POSTGRES_USER=maxterview
POSTGRES_PASSWORD=change-me
POSTGRES_DB=maxterview

BACKEND_PORT=8000
FRONTEND_PORT=5173

# Neon MCP server auth (README "Driving Neon from an agent"). Read by the MCP adapter via
# direnv, not by the app, from the block `make env-pull` writes below. Compose injects it into the
# backend container by `env_file` too, where it is harmless (that container already holds
# DATABASE_URL, i.e. direct prod DB access).
# For PROD, does not touch current DEV environment. Only for deep harness for Pi agents (proceed with caution).
# NEON_API_KEY=np_...

# Grafana Cloud service-account token for the local grafana MCP server. Read at connect time by
# .mcp.json (the same pattern as NEON_API_KEY above), filled by the same `make env-pull`. The Loki
# write credential lives in Infisical.
# GRAFANA_SERVICE_ACCOUNT_TOKEN=glsa_...

