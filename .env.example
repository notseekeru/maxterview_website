# Copy to `.env` and fill in real values. NEVER commit `.env`.

APP_ENV=development
LOG_LEVEL=INFO

POSTGRES_USER=maxterview
POSTGRES_PASSWORD=change-me
POSTGRES_DB=maxterview

BACKEND_PORT=8000
FRONTEND_PORT=5173

# ==============================================================================
# AUTH — Clerk (NOT secret values; public app identifiers).
# For MVP/dev: leave CLERK_ENABLED=false → auth bypassed with a dev user.
#
#   PRE-SHIP CHECKLIST — when going live (after M5–M9), set ALL of these:
#     1. CLERK_ENABLED=true
#     2. CLERK_DOMAIN     = your real Clerk frontend API, e.g.
#                           <slug>.clerk.accounts      (from Clerk dashboard → API Keys)
#     3. CLERK_JWKS_URL   = https://<slug>.clerk.accounts/.well-known/jwks.json
#     4. CLERK_AUDIENCE   = your application's audience claim (optional; if empty,
#                           the audience check is skipped). Set only if your
#                           Clerk JWT carries an `aud` you want enforced.
#
#   NOTE: CLERK_ENABLED=false is only allowed when APP_ENV is development/test;
#   otherwise the backend refuses to boot (D2 guard).
#
#   Frontend key (NOT in this file): VITE_CLERK_PUBLISHABLE_KEY in `frontend/.env`.
# ==============================================================================
CLERK_ENABLED=false
CLERK_DOMAIN=your-clerk-domain.clerk.accounts
CLERK_JWKS_URL=https://your-clerk-domain.clerk.accounts/.well-known/jwks.json
CLERK_AUDIENCE=
