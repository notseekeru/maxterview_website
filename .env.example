# Root `.env`: compose/infra values plus the two MCP tokens. Copy to `.env`, then `make env-pull`.
# Backend runtime config lives in `backend/.env`; `VITE_*` lives in `frontend/.env`.
# `DATABASE_URL` and `MIGRATE_DATABASE_URL` are derived (D5), never set here.

APP_ENV=development
POSTGRES_USER=maxterview
POSTGRES_PASSWORD=change-me
POSTGRES_DB=maxterview
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Filled by `make env-pull` (Infisical dev); read by the Neon and Grafana MCP servers via direnv.
# NEON_API_KEY=np_...
# GRAFANA_SERVICE_ACCOUNT_TOKEN=glsa_...
