{
    "name": "maxterview-backend",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "tsx watch src/main.ts",
        "build": "tsc -p tsconfig.json",
        "start": "node dist/main.js",
        "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
        "lint": "biome check . --write",
        "test": "vitest run",
        "migrate": "tsx scripts/migrate.ts"
    },
    "dependencies": {
        "@hono/node-server": "2.1.8",
        "@hono/zod-validator": "0.9.1",
        "@opentelemetry/exporter-metrics-otlp-http": "0.301.2",
        "@opentelemetry/exporter-trace-otlp-http": "0.301.2",
        "@opentelemetry/sdk-node": "0.301.2",
        "hono": "4.13.18",
        "jose": "6.2.17",
        "pino": "10.4.0",
        "postgres": "4.1.1",
        "unpdf": "2.2.0",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@biomejs/biome": "2.4.16",
        "@types/node": "26.6.6",
        "msw": "3.0.5",
        "pino-pretty": "13.2.0",
        "tsx": "4.23.15",
        "typescript": "7.0.2",
        "vitest": "5.1.0"
    }
}
