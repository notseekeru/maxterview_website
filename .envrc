use flake

# Export `.env` (git-ignored) into the shell so tools that read from the environment, the Neon and
# Grafana MCP servers, can see their tokens. Keep secrets in `.env`, NOT here: .envrc itself IS
# tracked by git.
dotenv_if_exists .env

# Bytecode lands in the repo tree otherwise, which fills searches with hits; the container sets its own.
export PYTHONPYCACHEPREFIX="${XDG_CACHE_HOME:-$HOME/.cache}/pycache"
