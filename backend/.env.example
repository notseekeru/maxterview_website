# Backend runtime config. Copy to `backend/.env`, then `make env-sync-dev` fills the credential block.
# Compose loads root `.env` first, so this file wins on collisions.
# Do not hand-set the credentials: the block is rewritten on every sync, and a stray copy is replaced.
# Billing rules: MONETIZATION.md. Voice: VOICE.md. BYOK: BYOK.md.

LOG_LEVEL=INFO
# Empty = no telemetry exporter at all.
OTEL_EXPORTER_OTLP_ENDPOINT=

# false = DEV_USER fallback, allowed only when APP_ENV is development or test.
CLERK_ENABLED=false
CLERK_DOMAIN=https://<YOUR-INSTANCE>.clerk.accounts.dev
CLERK_JWKS_URL=https://<YOUR-INSTANCE>.clerk.accounts.dev/.well-known/jwks.json
CLERK_AUDIENCE=
# Host tooling only (`npx clerk`, clerk-mint.sh); the app never reads it.
CLERK_FRONTEND_API=<YOUR-INSTANCE>.clerk.accounts.dev

# Per pod: each slot is one Neon connection.
DB_POOL_MAX=20

# Empty LLM_BASE_URL or LLM_MODEL = STUB_MODE: deterministic fake interviews, no network.
LLM_BASE_URL=
LLM_MODEL=
# Optional: Pro's interview turn on a larger model. Empty LLM_PRO_MODEL = every tier runs LLM_MODEL.
# Chat only; grading stays on LLM_GRADER_*. Base URL and key fall back to the LLM_* pair.
LLM_PRO_BASE_URL=
LLM_PRO_MODEL=
LLM_PRO_API_KEY=
# Optional: point the grader at a different model than the formatter.
LLM_GRADER_BASE_URL=
LLM_GRADER_MODEL=
LLM_MAX_TOKENS=512
LLM_MAX_GRADER_TOKENS=1024
LLM_MAX_FEEDBACK_TOKENS=1024
LLM_MAX_REVIEW_TOKENS=1800
LLM_DISABLE_THINKING=true
# true only when the model runs on your own machine; otherwise a private base_url is refused.
BYOK_ALLOW_PRIVATE_HOSTS=false

# Daily credits per owner across all interviews, reset 00:00 UTC.
FREE_CHAT_TURNS=30
PREMIUM_CHAT_TURNS=300
DEV_CHAT_TURNS=100000000
BYOK_CHAT_TURNS=600
BYOK_PREMIUM_CHAT_TURNS=5000
# Review redos per run; a finished run keeps its allowance.
FREE_REDOS=1
PREMIUM_REDOS=10
DEV_REDOS=10

# period = one payment buys PREMIUM_PERIOD_DAYS, no account capability needed; subscription needs
# PAYMONGO_PLAN_ID. An empty PAYMONGO_SECRET_KEY makes /api/billing/* answer 503.
BILLING_MODE=period
PAYMONGO_PLAN_ID=
PREMIUM_PRICE_CENTAVOS=9900
PREMIUM_PERIOD_DAYS=30
FRONTEND_BASE_URL=http://localhost:5173
# Empty = the webhook fails closed. Register payment.paid plus the two refund events.
PAYMONGO_WEBHOOK_SECRET=

# Empty or `off` disables the in-process limiter. N replicas grant N times the budget.
RATE_LIMIT=120/minute
# Exact origins, comma-separated, never `*`. Empty is correct: the SPA calls the API same-origin.
CORS_ALLOW_ORIGINS=

# Empty CLOUDFLARE_* = the voice controls disable themselves and say why.
CLOUDFLARE_TTS_MODEL=@cf/deepgram/aura-1
CLOUDFLARE_TTS_SPEAKER=hera
CLOUDFLARE_STT_MODEL=@cf/openai/whisper-large-v3-turbo

# Filled by `make env-sync-dev` (Infisical dev).
# CLERK_SECRET_KEY=
# PAYMONGO_SECRET_KEY=
# BYOK_ENCRYPTION_KEY=
# LLM_API_KEY=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
