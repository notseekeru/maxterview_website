# Backend runtime config template. Copy to `backend/.env` (git-ignored) and fill in real values.
#
# Compose loads BOTH files — env_file: [.env, ./backend/.env] — so backend/.env overrides root
# on collisions. Infra-only vars (APP_ENV, POSTGRES_*, ports) live in the ROOT `.env";

# ------------------------------------------------------------------------------
# Runtime
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
# OTLP traces + metrics (app/telemetry.py). Set it to the in-cluster Alloy receiver
# (http://maxterview-alloy:4318 in prod) to turn both on. EMPTY IS A SUPPORTED VALUE: no SDK, no
# exporter, no per-call branching, nothing exported. Never point this at Grafana directly, because
# the app is not allowed to hold a telemetry write credential.
OTEL_EXPORTER_OTLP_ENDPOINT=
# ------------------------------------------------------------------------------
# AUTH — Clerk (public app identifiers, not secrets).
#   These come from your Clerk Dashboard → your app → "Settings → API keys", on the
#   DEVELOPMENT instance you run locally (a `.clerk.accounts.dev` domain + pk_/sk_test_).
#   Production (`.seekeru.tech`) keys are locked to that origin and won't work on localhost.
#   CLERK_ENABLED=true for real auth; false (=DEV_USER) is allowed only when APP_ENV=development/test.
#   The frontend key goes in frontend/.env ($VITE_CLERK_PUBLISHABLE_KEY), not here.
#   NOTE: the backend verifies JWTs with the PUBLIC JWKS URL only.
# ------------------------------------------------------------------------------
CLERK_ENABLED=false
CLERK_DOMAIN=https://<YOUR-INSTANCE>.clerk.accounts.dev
CLERK_JWKS_URL=https://<YOUR-INSTANCE>.clerk.accounts.dev/.well-known/jwks.json
CLERK_AUDIENCE=

# Read by the backend for the billing email lookup ONLY (app/auth.py::user_email): Clerk's default
# session token carries no `email` claim, so checkout fetches the address from the Backend API.
# Empty = claim-only, which refuses every real user with a 409. Also used by host tooling
# (`npx clerk`, clerk-mint.sh); CLERK_FRONTEND_API is tooling-only and never read by the app.
CLERK_SECRET_KEY=sk_test_...
CLERK_FRONTEND_API=<YOUR-INSTANCE>.clerk.accounts.dev

# ------------------------------------------------------------------------------
# LLM — OpenAI-compatible (D7). ONE managed model for dev and prod (shipped: NVIDIA Nemotron).
#   Empty LLM_BASE_URL => STUB_MODE (deterministic, no network) so MVP/tests run
#   model-free. Keys are env-only, never in code.
#   Shipped value (dev + prod): https://integrate.api.nvidia.com/v1 with
#   nvidia/nemotron-3-super-120b-a12b; that host authenticates, so LLM_API_KEY is required.
#   A self-hosted llama.cpp/vLLM box is a supported swap, just not the shipping choice.
# ------------------------------------------------------------------------------
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Two-stage feedback (grader -> formatter). Stage-1 (grader) can ride a DIFFERENT model/
# provider than the cheap stage-2 formatter: set LLM_GRADER_* to point the grader at a
# stronger model (e.g. deepseek-reasoner) while LLM_MODEL stays the fast one. When unset,
# both stages share the single LLM_MODEL/LLM_BASE_URL above.
LLM_GRADER_BASE_URL=
LLM_GRADER_MODEL=

# BYOK (settings panel -> /settings/system): lets an OWNER point their interviews at their
# own OpenAI-compatible provider + key. Keys are Fernet-encrypted with this key before they
# touch the DB, and only its last 4 characters are ever read back. Unset = BYOK off (saves get
# a 503, the card renders read-only, interviews use the system LLM_* above). Generate once:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating/losing it orphans saved rows: they degrade to the system provider until re-saved.
# See BYOK.md.
BYOK_ENCRYPTION_KEY=

# BYOK destinations: the backend makes the request, so a private base_url (tailnet, LAN, k8s API,
# node metadata, localhost) is a probe into this deployment's own network and is refused, as is the
# deployment's own LLM_* origin while it needs no key. true = permit private addresses, which only a
# single-operator fork running the model on its own box wants: on a hosted deployment localhost is
# the POD, not the user's laptop.
BYOK_ALLOW_PRIVATE_HOSTS=false

#   Stage 2 (formatter) asks for response_format=json_schema and auto-downgrades to
#   json_object when the provider rejects it (logged at info as json_schema_unsupported).

# Max output tokens (bounds runaway local thinking models). Env-overridable per-deploy.
# LLM_MAX_GRADER_TOKENS bounds the grader's free-text notes; LLM_MAX_FEEDBACK_TOKENS
# bounds the formatter's JSON.
LLM_MAX_TOKENS=512
LLM_MAX_GRADER_TOKENS=1024
LLM_MAX_FEEDBACK_TOKENS=1024
LLM_DISABLE_THINKING=true

# ------------------------------------------------------------------------------
# MONETIZATION (M10) — free/premium/dev chat-turn quotas. Turn-based (no token metering).
#   Global DAILY credits PER OWNER (across ALL interviews), reset at 00:00 UTC.
#   (no-Clerk dev-fallback identity only, never prod). Enforced in app/billing.py.
#   Counter: `turn_usage` table keyed by (owner_id, UTC day).
# ------------------------------------------------------------------------------
FREE_CHAT_TURNS=10
PREMIUM_CHAT_TURNS=100
DEV_CHAT_TURNS=100000000
# BYOK ceilings: replace the TIER cap for an owner running their own provider, and are per tier
# (BYOK.md). Never waived - an unmetered waiver is a free ride on the base_url's GPU.
BYOK_CHAT_TURNS=300
BYOK_PREMIUM_CHAT_TURNS=5000
# Review redos: PER RUN (a finished run keeps its allowance). Charged only when a rebuild produced a
# review, so a model outage never costs the owner one.
FREE_REDOS=1
PREMIUM_REDOS=10
DEV_REDOS=10

# ------------------------------------------------------------------------------
# PAYMONGO (M10 billing) — zero-touch: real keys only in `backend/.env`
#   Test keys (`sk_test_...`) are available in the PayMongo Dashboard → Developers right after
#   signup. LIVE keys work on an Individual account for QR Ph (a real ₱99 payment landed
#   2026-09-27); the e-wallets and cards need a Fully Verified account (DTI + BIR 2303).
#   Subscriptions and Card Vaulting are not self-service — email support@paymongo.com to enable
#   them on the account before live keys will work.
#     PAYMONGO_SECRET_KEY      sk_test_... (server-side only)
#     PAYMONGO_WEBHOOK_SECRET  signing secret of the endpoint registered for /api/billing/webhook
#                              (Developers → Webhooks; HMAC-SHA256 of "{t}.{raw_body}" sent as the
#                              `Paymongo-Signature` header). Without it the webhook fails closed.
#                              Register for `payment.paid` PLUS `payment.refunded` and
#                              `payment.refund.updated`: the refund types are what revokes premium,
#                              and an endpoint that only has `payment.paid` never downgrades a refunded
#                              payer. `payment_intent.succeeded` is rejected with `parameter_invalid`,
#                              so the handler's acceptance of it only ever fires from /webhook/simulate.
#                              Re-running --register-webhook on an existing URL PUTs the event list,
#                              keeping this secret.
#     FRONTEND_BASE_URL        return URL a redirect rail comes back to (QR Ph ignores it)
#   BILLING_MODE — how money becomes a paid period on the `subscriptions` row; the reader
#   (`billing.resolve_tier`) is the same for both, so switching is one env var and no migration:
#     period (default)      one-time Payment Intent → QR Ph scanned in the page → `payment.paid`
#                           extends `current_period_end`. Needs NO account capability. No auto-renew.
#     subscription          provider-managed recurring. Needs PAYMONGO_PLAN_ID plus Subscriptions
#                           and Card Vaulting enabled by support@paymongo.com (not self-service).
#   Method availability is per ACCOUNT and differs between test and live mode: the live account
#   refuses paymaya/gcash/grab_pay/billease, so `qrph` is the only rail it can take money on (card is
#   enabled but needs KYB plus a PCI-scoped form). Verify with `POST /v1/payment_methods` against the
#   real key before shipping a PERIOD_METHODS change.
#     PREMIUM_PRICE_CENTAVOS   period mode: cost of one payment (default 9900 = ₱99)
#     PREMIUM_PERIOD_DAYS      period mode: premium bought per payment (default 30)
#     PAYMONGO_PLAN_ID         subscription mode only — create once:
#                              .pi/skills/paymongo-operator/scripts/paymongo-stub.sh --create-plan
#   Optional: PAYMONGO_SIGNATURE_TOLERANCE_S (default 300) — replay window for `Paymongo-Signature`.
#   Raise it only if `paymongo.webhook_signature.stale` shows real deliveries being dropped.
# ------------------------------------------------------------------------------
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_PLAN_ID=
BILLING_MODE=period
PREMIUM_PRICE_CENTAVOS=9900
PREMIUM_PERIOD_DAYS=30
FRONTEND_BASE_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# SECURITY (M11) — app-level hardening. See PLAN §7.
# ------------------------------------------------------------------------------
# Per-client rate limit for every route except /health (ingress `limit-rps` runs first; this is the
# in-app backstop). `limits` syntax, e.g. 120/minute, 30/second. Empty or `off` disables it.
# In-process storage: N replicas grant N× the budget (see app/ratelimit.py).
RATE_LIMIT=120/minute
# Cross-origin allow-list, comma-separated EXACT origins and never `*`. Empty is the shipping
# config: the SPA reaches the API same-origin through the nginx/Vite `/api` proxy, so no CORS
# middleware is registered at all. Set only if the API is called from another origin.
CORS_ALLOW_ORIGINS=

# ------------------------------------------------------------------------------
# VOICE (M16) — Workers AI. Optional infrastructure, not required config: fill both
# and the interviewer speaks and answers can be dictated. Leave them empty and the
# chat surface disables both controls and says why, instead of failing on click.
# See VOICE.md.
# ------------------------------------------------------------------------------
# Account ID (dashboard URL) and an API token with the "Workers AI - Read" policy.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Models. The voice default is Aura-1 because MeloTTS answers `AiError: Internal
# server error` from this account on every request, and because Aura is the human
# voice while MeloTTS was the generic one that got the browser engines killed (V1).
# Aura-2 is slower per sentence and costs the same; whisper turbo returns text only.
CLOUDFLARE_TTS_MODEL=@cf/deepgram/aura-1
# The voice is cast, not inherited: Aura-1 answers `angus` (an Irish man) when this
# is left out. `hera` is Deepgram's smooth, warm, professional adult American female.
# The other Aura-1 female voices: asteria, luna, athena, stella.
CLOUDFLARE_TTS_SPEAKER=hera
CLOUDFLARE_STT_MODEL=@cf/openai/whisper-large-v3-turbo
