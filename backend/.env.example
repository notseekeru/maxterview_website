# Backend config reference.
#
# The backend is run via Docker Compose, which reads the ROOT `.env` (see that file
# for the canonical, compose-consumed shape). This file documents the backend-relevant
# variables and their defaults for a standalone `uv run uvicorn app.main:app` run.
#
# REAL SECRETS (DATABASE_URL, LLM_API_KEY, Clerk keys, Stripe keys) are NEVER committed:
# they live only in the root/.env (git-ignored) or a k8s Secret in prod.

# ------------------------------------------------------------------------------
# Runtime
# ------------------------------------------------------------------------------
# Allowed values: development | production | test.
#   development/test => Clerk fallback (CLERK_ENABLED=false) permitted.
#   production       => refuses to boot unless CLERK_ENABLED=true (D2 guard).
APP_ENV=development
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# AUTH — Clerk (public app identifiers, not secrets).
#   Pre-ship checklist: set ALL of these (CLERK_ENABLED=true, real domain/JWKS,
#   and CLERK_AUDIENCE if your Clerk JWT carries an `aud`).
#   CLERK_ENABLED=false is only allowed when APP_ENV is development/test.
#   Frontend key lives in frontend/.env as VITE_CLERK_PUBLISHABLE_KEY (not here).
# ------------------------------------------------------------------------------
CLERK_ENABLED=false
CLERK_DOMAIN=your-clerk-domain.clerk.accounts
CLERK_JWKS_URL=https://your-clerk-domain.clerk.accounts/.well-known/jwks.json
CLERK_AUDIENCE=

# ------------------------------------------------------------------------------
# LLM — OpenAI-compatible (D7). Local model on dev; DeepSeek on prod.
#   Empty LLM_BASE_URL => STUB_MODE (deterministic, no network) so MVP/tests run
#   model-free. Keys are env-only, never in code.
#   Dev example (llama.cpp): http://100.64.2.2:8080/v1
#   Prod example (DeepSeek): https://api.deepseek.com/v1
# ------------------------------------------------------------------------------
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Max output tokens (bounds runaway local thinking models). Env-overridable per-deploy.
LLM_MAX_TOKENS=512
LLM_MAX_FEEDBACK_TOKENS=1024
LLM_DISABLE_THINKING=true

# ------------------------------------------------------------------------------
# MONETIZATION (M10) — free/premium chat-turn quotas. Turn-based (no token metering).
#   No daily-interview cap (interviews are unlimited at creation; the only gate is
#   the per-interview chat-turn cap). Free = 8 turns; Premium = 100 (via Stripe/Clerk
#   `subscriptions`). Enforced in app/billing.py.
# ------------------------------------------------------------------------------
FREE_CHAT_TURNS=8
PREMIUM_CHAT_TURNS=100

# ------------------------------------------------------------------------------
# STRIPE (M10 raw Stripe billing) — zero-touch: real keys only in root/.env
# (dev/Stripe CLI) or a k8s Secret/infra (prod). Never committed.
#   STRIPE_SECRET_KEY      sk_test_.../sk_live_... (server-side only)
#   STRIPE_WEBHOOK_SECRET  whsec_... (for /billing/webhook signature verify)
#   STRIPE_PRICE_ID        price_... (the $9.99/mo premium price)
#   FRONTEND_BASE_URL      success/cancel + portal return URL
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
FRONTEND_BASE_URL=http://localhost:5173
