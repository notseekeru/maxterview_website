# Backend runtime config template. Copy to `backend/.env` (git-ignored) and fill in real values.
#
# Compose loads BOTH files — env_file: [.env, ./backend/.env] — so backend/.env overrides root
# on collisions. Infra-only vars (APP_ENV, POSTGRES_*, ports) live in the ROOT `.env";

# ------------------------------------------------------------------------------
# Runtime
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
# ------------------------------------------------------------------------------
# AUTH — Clerk (public app identifiers, not secrets).
#   These come from your Clerk Dashboard → your app → "Settings → API keys", on the
#   DEVELOPMENT instance you run locally (a `.clerk.accounts.dev` domain + pk_/sk_test_).
#   Production (`.seekeru.tech`) keys are locked to that origin and won't work on localhost.
#   CLERK_ENABLED=true for real auth; false (=DEV_USER) is allowed only when APP_ENV=development/test.
#   The frontend key goes in frontend/.env ($VITE_CLERK_PUBLISHABLE_KEY), not here.
#   NOTE: the backend verifies JWTs with the PUBLIC JWKS URL only.
# ------------------------------------------------------------------------------
CLERK_ENABLED=false
CLERK_DOMAIN=https://<YOUR-INSTANCE>.clerk.accounts.dev
CLERK_JWKS_URL=https://<YOUR-INSTANCE>.clerk.accounts.dev/.well-known/jwks.json
CLERK_AUDIENCE=

# Host tooling only (`npx clerk`, clerk-mint.sh) — the backend never reads these, but `env_file`
# injects them into the backend container anyway, so they can live in a shell export instead.
CLERK_SECRET_KEY=sk_test_...
CLERK_FRONTEND_API=<YOUR-INSTANCE>.clerk.accounts.dev

# ------------------------------------------------------------------------------
# LLM — OpenAI-compatible (D7). ONE self-hosted model for dev and prod (shipped: qwen).
#   Empty LLM_BASE_URL => STUB_MODE (deterministic, no network) so MVP/tests run
#   model-free. Keys are env-only, never in code.
#   Shipped value (dev + prod): http://100.64.2.2:8080/v1 (the desktop llama over Tailscale,
#   unauthenticated => LLM_API_KEY stays empty; prod keeps that host always-on).
#   A managed provider (https://api.deepseek.com/v1) is a supported swap, just not the
#   shipping choice.
# ------------------------------------------------------------------------------
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Two-stage feedback (grader -> formatter). Stage-1 (grader) can ride a DIFFERENT model/
# provider than the cheap stage-2 formatter: set LLM_GRADER_* to point the grader at a
# stronger model (e.g. deepseek-reasoner) while LLM_MODEL stays the fast one. When unset,
# both stages share the single LLM_MODEL/LLM_BASE_URL above.
LLM_GRADER_BASE_URL=
LLM_GRADER_MODEL=

# BYOK (settings panel -> /app/settings/system): lets an OWNER point their interviews at their
# own OpenAI-compatible provider + key. Keys are Fernet-encrypted with this key before they
# touch the DB, and only its last 4 characters are ever read back. Unset = BYOK off (saves get
# a 503, the card renders read-only, interviews use the system LLM_* above). Generate once:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating/losing it orphans saved rows: they degrade to the system provider until re-saved.
# See BYOK.md.
BYOK_ENCRYPTION_KEY=

#   Stage 2 (formatter) asks for response_format=json_schema and auto-downgrades to
#   json_object when the provider rejects it (logged at info as json_schema_unsupported).

# Max output tokens (bounds runaway local thinking models). Env-overridable per-deploy.
# LLM_MAX_GRADER_TOKENS bounds the grader's free-text notes; LLM_MAX_FEEDBACK_TOKENS
# bounds the formatter's JSON.
LLM_MAX_TOKENS=512
LLM_MAX_GRADER_TOKENS=1024
LLM_MAX_FEEDBACK_TOKENS=1024
LLM_DISABLE_THINKING=true

# ------------------------------------------------------------------------------
# MONETIZATION (M10) — free/premium/dev chat-turn quotas. Turn-based (no token metering).
#   Global DAILY credits PER OWNER (across ALL interviews), reset at 00:00 UTC.
#   (no-Clerk dev-fallback identity only, never prod). Enforced in app/billing.py.
#   Counter: `turn_usage` table keyed by (owner_id, UTC day).
# ------------------------------------------------------------------------------
FREE_CHAT_TURNS=30
PREMIUM_CHAT_TURNS=250
DEV_CHAT_TURNS=500

# ------------------------------------------------------------------------------
# PAYMONGO (M10 billing) — zero-touch: real keys only in `backend/.env`
#   Test keys (`sk_test_...`) are available in the PayMongo Dashboard → Developers right after
#   signup; LIVE keys need a Fully Verified account (DTI + BIR 2303 for a PH sole prop).
#   Subscriptions and Card Vaulting are not self-service — email support@paymongo.com to enable
#   them on the account before live keys will work.
#     PAYMONGO_SECRET_KEY      sk_test_... (server-side only)
#     PAYMONGO_WEBHOOK_SECRET  signing secret of the endpoint registered for /api/billing/webhook
#                              (Developers → Webhooks; HMAC-SHA256 of "{t}.{raw_body}" sent as the
#                              `Paymongo-Signature` header). Without it the webhook fails closed.
#                              Register for `payment.paid` AND `payment_intent.succeeded`.
#     FRONTEND_BASE_URL        first-payment return URL
#   BILLING_MODE — how money becomes a paid period on the `subscriptions` row; the reader
#   (`billing.resolve_tier`) is the same for both, so switching is one env var and no migration:
#     period (default)      one-time Payment Intent → Maya redirect → `payment.paid` extends
#                           `current_period_end`. Needs NO account capability. No auto-renew.
#     subscription          provider-managed recurring. Needs PAYMONGO_PLAN_ID plus Subscriptions
#                           and Card Vaulting enabled by support@paymongo.com (not self-service).
#   Maya works on an individual account; Cards need a registered business type.
#     PREMIUM_PRICE_CENTAVOS   period mode: cost of one payment (default 49900 = ₱499)
#     PREMIUM_PERIOD_DAYS      period mode: premium bought per payment (default 30)
#     PAYMONGO_PLAN_ID         subscription mode only — create once:
#                              .pi/skills/paymongo-operator/scripts/paymongo-stub.sh --create-plan
#   Optional: PAYMONGO_SIGNATURE_TOLERANCE_S (default 300) — replay window for `Paymongo-Signature`.
#   Raise it only if `paymongo.webhook_signature.stale` shows real deliveries being dropped.
# ------------------------------------------------------------------------------
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_PLAN_ID=
BILLING_MODE=period
PREMIUM_PRICE_CENTAVOS=49900
PREMIUM_PERIOD_DAYS=30
FRONTEND_BASE_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# SECURITY (M11) — app-level hardening. See PLAN §7.
# ------------------------------------------------------------------------------
# Per-client rate limit for every route except /health (ingress `limit-rps` runs first; this is the
# in-app backstop). `limits` syntax, e.g. 120/minute, 30/second. Empty or `off` disables it.
# In-process storage: N replicas grant N× the budget (see app/ratelimit.py).
RATE_LIMIT=120/minute
# Cross-origin allow-list, comma-separated EXACT origins and never `*`. Empty is the shipping
# config: the SPA reaches the API same-origin through the nginx/Vite `/api` proxy, so no CORS
# middleware is registered at all. Set only if the API is called from another origin.
CORS_ALLOW_ORIGINS=
