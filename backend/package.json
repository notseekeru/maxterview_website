{
    "name": "maxterview-backend",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "tsx watch src/main.ts",
        "build": "tsc -p tsconfig.json && tsc -p tsconfig.scripts.json",
        "start": "node dist/main.js",
        "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
        "lint": "biome check . --fix --unsafe",
        "test": "vitest run",
        "migrate": "tsx scripts/migrate.ts"
    },
    "dependencies": {
        "@hono/node-server": "2.1.11",
        "@hono/otel": "1.4.1",
        "@opentelemetry/api": "1.10.0",
        "@opentelemetry/exporter-metrics-otlp-http": "0.301.2",
        "@opentelemetry/exporter-trace-otlp-http": "0.301.2",
        "@opentelemetry/resources": "3.1.1",
        "@opentelemetry/sdk-metrics": "3.1.1",
        "@opentelemetry/sdk-node": "0.301.2",
        "hono": "4.13.23",
        "jose": "6.2.18",
        "pino": "10.4.0",
        "postgres": "4.1.1",
        "unpdf": "2.2.3",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@biomejs/biome": "2.6.9",
        "@types/node": "26.6.11",
        "tsx": "4.23.15",
        "typescript": "7.0.2",
        "vitest": "5.1.2"
    }
}
