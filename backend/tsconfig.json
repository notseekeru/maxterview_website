{
    "compilerOptions": {
        "target": "es2024",
        "lib": ["es2024"],
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "types": ["node"],
        "strict": true,
        "verbatimModuleSyntax": true,
        "allowImportingTsExtensions": true,
        "rewriteRelativeImportExtensions": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "rootDir": "src",
        "outDir": "dist",
        "sourceMap": true
    },
    "include": ["src"]
}
